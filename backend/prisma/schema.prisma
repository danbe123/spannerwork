enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  excerpt         String
  content         String         @db.Text
  featuredImage   String?
  category        String
  tags            String[]
  author          String
  authorAvatar    String?
  readTime        Int            @default(5)
  status          BlogPostStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String?
  updatedById     String?
  metaTitle       String?
  metaDescription String?
  createdBy       User?          @relation("blog_posts_createdBy", fields: [createdById], references: [id])
  updatedBy       User?          @relation("blog_posts_updatedBy", fields: [updatedById], references: [id])

  @@index([status, publishedAt])
  @@index([category])
  @@index([slug])
  @@map("blog_posts")
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  requestId   String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId])
  @@index([requestId])
  @@map("bookmarks")
}

// ============================================
// B2B Trade Account & Invoicing Models
// ============================================

model InvoiceSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  businessName  String?
  logoUrl       String?
  address       String?
  city          String?
  postcode      String?
  country       String?  @default("GB")
  vatNumber     String?
  vatRegistered Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoice_settings")
}

model Invoice {
  id               String      @id @default(cuid())
  invoiceNumber    String      @unique
  transactionId    String
  userId           String
  type             InvoiceType
  recipientName    String
  recipientAddress String?
  recipientVat     String?
  issueDate        DateTime    @default(now())
  subtotal         Int         // Amount in pence before VAT
  vatAmount        Int         // VAT amount in pence (20%)
  totalAmount      Int         // Total in pence including VAT
  lineItems        Json        // Array of line items
  pdfUrl           String?
  purchaseOrder    String?     // B2B purchase order reference
  createdAt        DateTime    @default(now())
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([transactionId])
  @@index([invoiceNumber])
  @@map("invoices")
}

enum InvoiceType {
  RENTER   // Invoice for the customer/renter
  PROVIDER // Invoice for provider income
}

// FIX #8: Invoice sequence table to prevent race conditions
// Guarantees unique invoice numbers even under concurrent requests
model InvoiceSequence {
  year       Int      @id // Year (e.g., 2026)
  lastNumber Int      @default(0) // Last assigned invoice number for this year
  updatedAt  DateTime @updatedAt

  @@map("invoice_sequences")
}

model TradeAccount {
  id                    String       @id @default(cuid())
  userId                String       @unique
  accountType           AccountType  @default(INDIVIDUAL)
  companyName           String?
  companyRegistrationNo String?
  vatNumber             String?
  billingAddress        String?
  billingCity           String?
  billingPostcode       String?
  billingCountry        String?      @default("GB")
  bulkDiscountPercent   Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMembers           TeamMember[]

  @@map("trade_accounts")
}

enum AccountType {
  INDIVIDUAL
  COMPANY
}

model TeamMember {
  id             String       @id @default(cuid())
  tradeAccountId String
  userId         String
  email          String       // Email used for invitation
  role           TeamRole     @default(MEMBER)
  status         MemberStatus @default(PENDING)
  invitedAt      DateTime     @default(now())
  acceptedAt     DateTime?
  invitedById    String?
  tradeAccount   TradeAccount @relation(fields: [tradeAccountId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tradeAccountId, userId])
  @@index([userId])
  @@index([email])
  @@map("team_members")
}

enum TeamRole {
  ADMIN
  MEMBER
}

enum MemberStatus {
  PENDING
  ACTIVE
  REMOVED
}

// AI Feedback Tracking - for learning and improving AI suggestions
enum AIFeatureType {
  LISTING_GENERATION
  REQUEST_OPTIMIZATION
  LISTING_IMPROVEMENT
  MATCHING
  BUNDLE_SUGGESTION
  IMAGE_ANALYSIS
}

enum AIFeedbackAction {
  PENDING          // AI generated, user hasn't acted yet
  ACCEPTED_FULL    // User accepted AI output as-is
  ACCEPTED_PARTIAL // User accepted some fields, modified others
  REJECTED         // User dismissed AI suggestions
  REGENERATED      // User asked for new suggestions
}

model AIFeedback {
  id             String           @id @default(cuid())
  userId         String
  sessionId      String           // Group related interactions
  featureType    AIFeatureType
  inputData      Json             // Original user input
  outputData     Json             // AI-generated result
  action         AIFeedbackAction @default(PENDING)
  selectedFields String[]         // Which fields user kept
  modifiedFields Json?            // What user changed: {field: {original, modified}}
  finalData      Json?            // What user actually submitted
  promptVersion  String           // Track which prompt version
  modelUsed      String           // Which AI model was used
  latencyMs      Int              // Response time for performance tracking
  confidence     Float?           // AI's confidence score if available
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([featureType, action])
  @@index([userId, createdAt])
  @@index([promptVersion])
  @@index([createdAt])
  @@map("ai_feedback")
}

// ============================================
// Email Tracking & Reliability System
// ============================================

enum EmailStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
  CANCELLED
}

enum EmailPriority {
  LOW        // Marketing, newsletters
  NORMAL     // Standard notifications
  HIGH       // Auth, payment, booking confirmations
  CRITICAL   // Password reset, security alerts
}

model EmailLog {
  id                String       @id @default(cuid())
  jobId             String       @unique
  type              String       // 'verification', 'booking-confirmation', etc.
  recipientEmail    String
  recipientId       String?      // User ID if known
  status            EmailStatus  @default(QUEUED)
  priority          EmailPriority @default(NORMAL)
  provider          String?      // 'mailtrap', 'resend'
  providerMessageId String?
  subject           String?
  attempts          Int          @default(0)
  maxAttempts       Int          @default(3)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  bounceType        String?      // 'hard', 'soft'
  bounceReason      String?
  error             String?
  metadata          Json?        // Template variables, etc.
  idempotencyKey    String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  recipient         User?        @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([recipientEmail])
  @@index([recipientId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([recipientEmail, createdAt])
  @@map("email_logs")
}

model EmailTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique // 'welcome', 'booking-confirmation'
  name        String
  subject     String
  htmlBody    String   @db.Text
  textBody    String?  @db.Text
  variables   Json     // Expected variables schema
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  priority    EmailPriority @default(NORMAL)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@index([slug, isActive])
  @@index([isActive])
  @@map("email_templates")
}

model EmailBounce {
  id            String   @id @default(cuid())
  email         String   @unique
  bounceType    String   // 'hard', 'soft'
  bounceCount   Int      @default(1)
  lastBounceAt  DateTime @default(now())
  suppressed    Boolean  @default(false)
  suppressedAt  DateTime?
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([suppressed])
  @@map("email_bounces")
}
