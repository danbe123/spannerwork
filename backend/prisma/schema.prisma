generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivityEvent {
  id         String       @id @default(cuid())
  type       ActivityType
  actorId    String?
  targetType String?
  targetId   String?
  metadata   Json?
  isPublic   Boolean      @default(true)
  postcode   String?
  createdAt  DateTime     @default(now())

  @@index([actorId, createdAt])
  @@index([isPublic, createdAt])
  @@index([postcode, createdAt])
  @@index([type, createdAt])
  @@map("activity_events")
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  userId       String
  resourceType String?
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime @default(now())
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([resourceType, resourceId])
  @@index([timestamp])
  @@index([userId, timestamp])
  @@map("audit_logs")
}

// Webhook event tracking for idempotency
// Prevents duplicate processing when Stripe retries webhooks
model WebhookEvent {
  eventId     String   @id // Stripe event ID (e.g., evt_xxx)
  eventType   String   // Event type (e.g., transfer.created)
  processedAt DateTime @default(now())

  @@index([eventType, processedAt])
  @@map("webhook_events")
}

model DailyMetric {
  id              String   @id @default(cuid())
  date            DateTime @unique
  totalUsers      Int
  newUsers        Int
  activeUsers     Int
  totalListings   Int
  totalBookings   Int
  gmv             Int
  platformRevenue Int
  createdAt       DateTime @default(now())

  @@index([date])
  @@map("daily_metrics")
}

model DeletedFile {
  id                 String   @id @default(cuid())
  filename           String
  originalPath       String
  fileUrl            String
  ownerId            String
  ownerType          String
  resourceId         String?
  deletedAt          DateTime @default(now())
  deletedBy          String
  expiresAt          DateTime
  permanentlyDeleted Boolean  @default(false)

  @@index([expiresAt])
  @@index([ownerId])
  @@index([permanentlyDeleted, expiresAt])
  @@map("deleted_files")
}

model Dispute {
  id                                 String        @id @default(cuid())
  transactionId                      String
  initiatorId                        String
  respondentId                       String
  reason                             String
  description                        String
  status                             DisputeStatus @default(OPEN)
  resolution                         String?
  refundAmountInitiator              Int?
  refundAmountRespondent             Int?
  createdDate                        DateTime      @default(now())
  updatedDate                        DateTime @updatedAt
  resolvedDate                       DateTime?
  deadlineDate                       DateTime?
  initiator   User              @relation("disputes_initiatorIdTousers", fields: [initiatorId], references: [id], onDelete: Cascade)
  respondent  User              @relation("disputes_respondentIdTousers", fields: [respondentId], references: [id], onDelete: Cascade)
  transaction Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  evidence    DisputeEvidence[]

  @@index([status])
  @@index([transactionId])
  @@map("disputes")
}

model DisputeEvidence {
  id          String   @id @default(cuid())
  disputeId   String
  uploaderId  String
  fileUrl     String
  fileName    String
  fileType    String
  fileSize    Int
  description String?
  createdDate DateTime @default(now())
  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@index([uploaderId])
  @@map("dispute_evidence")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([token])
  @@index([userId])
  @@map("email_verification_tokens")
}

model LinkedAccount {
  id         String   @id @default(cuid())
  userId     String
  provider   String   // 'google', 'facebook', 'apple'
  providerId String   // External account ID from OAuth provider
  email      String?  // Email from OAuth provider (may differ from user email)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("linked_accounts")
}

model InsuranceDocument {
  id              String          @id @default(cuid())
  userId          String
  documentUrl     String
  documentType    InsuranceType   @default(PUBLIC_LIABILITY)
  provider        String?
  policyNumber    String?
  coverageAmount  Int?
  expiryDate      DateTime?
  status          InsuranceStatus @default(PENDING_REVIEW)
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  claims         InsuranceClaim[]

  @@index([expiryDate])
  @@index([status])
  @@index([userId, status])
  @@map("insurance_documents")
}

model InsuranceClaim {
  id                  String             @id @default(cuid())
  transactionId       String
  claimantId          String
  insuranceDocumentId String?
  claimType           InsuranceClaimType
  incidentDate        DateTime
  description         String
  claimAmount         Int                // Amount in pence
  status              InsuranceClaimStatus @default(SUBMITTED)
  adminNotes          String?
  settlementAmount    Int?               // Final settlement in pence
  rejectionReason     String?
  reviewedAt          DateTime?
  reviewedBy          String?
  settledAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  transaction         Transaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  claimant            User               @relation("claimsFiled", fields: [claimantId], references: [id], onDelete: Cascade)
  insuranceDocument   InsuranceDocument? @relation(fields: [insuranceDocumentId], references: [id], onDelete: SetNull)
  evidence            InsuranceClaimEvidence[]

  @@index([transactionId])
  @@index([claimantId])
  @@index([status])
  @@index([createdAt])
  @@map("insurance_claims")
}

model InsuranceClaimEvidence {
  id          String         @id @default(cuid())
  claimId     String
  uploaderId  String
  fileUrl     String
  fileName    String
  fileType    String
  fileSize    Int
  description String?
  createdAt   DateTime       @default(now())
  claim       InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  uploader    User           @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([uploaderId])
  @@map("insurance_claim_evidence")
}

model Message {
  id                                String    @id @default(cuid())
  senderId                          String
  recipientId                       String
  content                           String
  read                              Boolean   @default(false)
  readAt                            DateTime?
  createdDate                       DateTime  @default(now())
  updatedDate                       DateTime  @updatedAt
  recipient User    @relation("messages_recipientIdTousers", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User    @relation("messages_senderIdTousers", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([createdDate])
  @@index([recipientId, read])
  @@index([recipientId, createdDate])
  @@index([recipientId, senderId, createdDate])
  @@index([senderId])
  @@index([senderId, recipientId, createdDate])
  @@index([senderId, read])
  @@map("messages")
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  newMatchingRequests  Boolean  @default(true)
  requestResponses     Boolean  @default(true)
  bookingConfirmations Boolean  @default(true)
  bookingReminders     Boolean  @default(true)
  paymentAlerts        Boolean  @default(true)
  weekendAvailability  Boolean  @default(true)
  renewalReminders     Boolean  @default(true)
  reviewReminders      Boolean  @default(true)
  tipsAndSuggestions   Boolean  @default(true)
  communityUpdates     Boolean  @default(false)
  emailEnabled         Boolean  @default(true)
  pushEnabled          Boolean  @default(true)
  smsEnabled           Boolean  @default(false)
  quietHoursStart      Int?
  quietHoursEnd        Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("notification_preferences")
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

model QuickRebook {
  id           String   @id @default(cuid())
  userId       String
  listingType  String
  listingId    String
  providerId   String
  lastBookedAt DateTime
  bookingCount Int      @default(1)
  isFavorite   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingType, listingId])
  @@index([userId, lastBookedAt])
  @@map("quick_rebooks")
}

model Referral {
  id                                String         @id @default(cuid())
  referrerId                        String
  referredId                        String?
  code                              String         @unique
  email                             String?
  status                            ReferralStatus @default(PENDING)
  reward                            Int?
  createdDate                       DateTime       @default(now())
  updatedDate                       DateTime @updatedAt
  completedDate                     DateTime?
  phone                             String?
  referred User?         @relation("referrals_referredIdTousers", fields: [referredId], references: [id])
  referrer User          @relation("referrals_referrerIdTousers", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([referrerId])
  @@map("referrals")
}

model Request {
  id                String         @id @default(cuid())
  title             String
  description       String
  category          Category
  urgency           Urgency
  budget            Int
  rateType          RateType
  broadcastRadius   Int
  postcode          String
  locationAddress   String?
  locationLat       Float?
  locationLng       Float?
  photos            String[]
  status            RequestStatus  @default(ACTIVE)
  responseCount     Int            @default(0)
  seekerId          String
  sponsorCpaPercent Int            @default(0)  // 0-50, 0 means not sponsored
  expiresAt         DateTime
  createdDate       DateTime       @default(now())
  updatedDate       DateTime       @updatedAt
  seeker            User           @relation(fields: [seekerId], references: [id])
  transactions      Transaction[]
  bookmarks         Bookmark[]

  @@index([category])
  @@index([locationLat, locationLng])
  @@index([seekerId])
  @@index([seekerId, status])
  @@index([status, createdDate])
  @@index([status, expiresAt])
  @@index([category, status])
  @@index([sponsorCpaPercent, status, createdDate])
  @@map("requests")
}

model Review {
  id                                  String       @id @default(cuid())
  transactionId                       String
  reviewerId                          String
  reviewedUserId                      String
  rating                              Int
  comment                             String?
  createdDate                         DateTime     @default(now())
  updatedDate                         DateTime @updatedAt
  reviewedUser User        @relation("reviews_reviewedUserIdTousers", fields: [reviewedUserId], references: [id], onDelete: Cascade)
  reviewer     User        @relation("reviews_reviewerIdTousers", fields: [reviewerId], references: [id], onDelete: Cascade)
  transaction                        Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, reviewerId])
  @@index([reviewedUserId])
  @@index([reviewerId])
  @@index([transactionId])
  @@map("reviews")
}

model SavedSearch {
  id          String   @id @default(cuid())
  userId      String
  name        String
  filters     Json
  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

model Service {
  id                String         @id @default(cuid())
  name              String
  description       String
  specialties       String[]
  hourlyRate        Int
  calloutFee        Int?
  radius            Int
  photos            String[]
  available         Boolean        @default(true)
  postcode          String
  locationLat       Float?
  locationLng       Float?
  providerId        String
  sponsorCpaPercent Int            @default(0)  // 0-50, 0 means not sponsored
  createdDate       DateTime       @default(now())
  updatedDate       DateTime       @updatedAt
  requiresInsurance Boolean        @default(true)
  provider          User           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  availabilityHolds AvailabilityHold[]

  @@index([available])
  @@index([providerId])
  @@index([providerId, available, createdDate])
  @@index([locationLat, locationLng, available])
  @@map("services")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("sessions")
}

model Space {
  id                String         @id @default(cuid())
  name              String
  description       String
  hourlyRate        Int
  dailyRate         Int
  weeklyRate        Int?
  size              Int?
  features          String[]
  photos            String[]
  available         Boolean        @default(true)
  postcode          String
  locationAddress   String
  locationLat       Float?
  locationLng       Float?
  ownerId           String
  sponsorCpaPercent Int            @default(0)  // 0-50, 0 means not sponsored
  createdDate       DateTime       @default(now())
  updatedDate       DateTime       @updatedAt
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  availabilityHolds AvailabilityHold[]

  @@index([available])
  @@index([ownerId])
  @@index([ownerId, available, createdDate])
  @@index([locationLat, locationLng, available])
  @@map("spaces")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model SpatialRefSys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
  @@map("spatial_ref_sys")
}

model Tool {
  id                String         @id @default(cuid())
  name              String
  description       String
  category          String
  dailyRate         Int
  weeklyRate        Int?
  deposit           Int
  photos            String[]
  condition         String
  available         Boolean        @default(true)
  postcode          String
  locationLat       Float?
  locationLng       Float?
  ownerId           String
  sponsorCpaPercent Int            @default(0)  // 0-50, 0 means not sponsored
  createdDate       DateTime       @default(now())
  updatedDate       DateTime       @updatedAt
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  availabilityHolds AvailabilityHold[]

  @@index([available])
  @@index([category, available, dailyRate])
  @@index([category])
  @@index([ownerId, available])
  @@index([ownerId])
  @@index([ownerId, createdDate])
  @@index([locationLat, locationLng, available])
  @@map("tools")
}

model Transaction {
  id                                   String            @id @default(cuid())
  requestId                            String?
  toolId                               String?
  spaceId                              String?
  serviceId                            String?
  userId                               String
  providerId                           String?
  startDate                            DateTime
  endDate                              DateTime
  rentalFee                            Int
  platformFee                          Int
  totalAmount                          Int
  status                               TransactionStatus @default(PENDING)
  paymentStatus                        PaymentStatus     @default(PENDING)
  notes                                String?
  createdDate                          DateTime          @default(now())
  updatedDate                          DateTime @updatedAt
  completedDate                        DateTime?
  version                              Int               @default(1)
  customerWaiverAcceptedAt             DateTime?
  providerWaiverAcceptedAt             DateTime?
  stripePaymentIntentId                String?           @unique
  stripeTransferId                     String?           @unique
  waiverVersion                        String?
  providerPlanAtBooking                ProviderPlan      @default(FREE)
  platformFeePercent                   Int               @default(5)
  applicationFeeAmount                 Int               @default(0)
  instantPayoutSelected                Boolean           @default(false)
  instantPayoutFee                     Int               @default(0)
  instantPayoutFeeReimbursed           Boolean           @default(false)
  instantPayoutFeeReimbursedAt         DateTime?
  instantPayoutFeeTransferId           String?           @unique
  insuranceDamageProtectionSelected    Boolean           @default(false)
  insuranceDamageProtectionFee         Int               @default(0)
  insuranceLiabilitySelected           Boolean           @default(false)
  insuranceLiabilityFee                Int               @default(0)
  insuranceCancellationSelected        Boolean           @default(false)
  insuranceCancellationFee             Int               @default(0)
  stripeInstantPayoutId                String?           @unique
  purchaseOrderNumber                  String?           // B2B purchase order reference
  providerSponsorCpaPercent            Int               @default(0)  // Snapshotted from listing
  providerSponsorCpaFee                Int               @default(0)  // Fee in pence (calculated on completion)
  renterSponsorCpaPercent              Int               @default(0)  // Snapshotted from request
  renterSponsorCpaFee                  Int               @default(0)  // Fee in pence (calculated on completion)
  totalRefunded                        Int               @default(0)  // Cumulative refunded amount in pence
  cancelledById                        String?           // Tracks who initiated the cancellation (user or provider)
  disputes                             Dispute[]
  reviews                              Review[]
  insuranceClaims                      InsuranceClaim[]
  invoices                             Invoice[]
  provider User?            @relation("transactions_providerIdTousers", fields: [providerId], references: [id])
  request                             Request?         @relation(fields: [requestId], references: [id])
  service                             Service?         @relation(fields: [serviceId], references: [id])
  space                               Space?           @relation(fields: [spaceId], references: [id])
  tool                                Tool?            @relation(fields: [toolId], references: [id])
  user     User             @relation("transactions_userIdTousers", fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdDate])
  @@index([providerId])
  @@index([providerId, status])
  @@index([providerId, createdDate])
  @@index([serviceId, startDate, endDate])
  @@index([spaceId, startDate, endDate])
  @@index([startDate, endDate])
  @@index([status])
  @@index([status, completedDate])
  @@index([toolId, startDate, endDate])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdDate])
  @@index([requestId, status])
  @@map("transactions")
}

// FIX: Availability hold tokens to prevent race conditions between availability check and booking
model AvailabilityHold {
  id          String    @id @default(cuid())
  token       String    @unique @default(cuid())
  userId      String
  toolId      String?
  spaceId     String?
  serviceId   String?
  startDate   DateTime
  endDate     DateTime
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  consumed    Boolean   @default(false)  // Set to true when booking is created
  consumedAt  DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool    Tool?    @relation(fields: [toolId], references: [id], onDelete: Cascade)
  space   Space?   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([toolId, startDate, endDate, expiresAt])
  @@index([spaceId, startDate, endDate, expiresAt])
  @@index([serviceId, startDate, endDate, expiresAt])
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("availability_holds")
}

model UserBadge {
  id       String    @id @default(cuid())
  userId   String
  badge    BadgeType
  earnedAt DateTime  @default(now())
  metadata Json?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
  @@index([userId])
  @@map("user_badges")
}

model UserStats {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  totalListings          Int      @default(0)
  totalRequests          Int      @default(0)
  totalRentalsAsRenter   Int      @default(0)
  totalRentalsAsProvider Int      @default(0)
  averageResponseMinutes Int?
  cancellationRate       Float    @default(0)
  completionRate         Float    @default(100)
  totalEarned            Int      @default(0)
  totalSpent             Int      @default(0)
  currentStreak          Int      @default(0)
  longestStreak          Int      @default(0)
  lastActiveAt           DateTime @default(now())
  successfulReferrals    Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_stats")
}

model User {
  id                                          String                      @id @default(cuid())
  email                                       String                      @unique
  passwordHash                                String?
  name                                        String?
  phone                                       String?
  avatar                                      String?
  bio                                         String?
  postcode                                    String?
  street                                      String?
  city                                        String?
  county                                      String?
  country                                     String?                     @default("GB")
  locationAddress                             String?
  locationLat                                 Float?
  locationLng                                 Float?
  role                                        Role                        @default(USER)
  accountStatus                               AccountStatus               @default(ACTIVE)
  emailVerified                               Boolean                     @default(false)
  emailVerifiedAt                             DateTime?
  phoneVerified                               Boolean                     @default(false)
  phoneVerifiedAt                             DateTime?
  insuranceVerified                           Boolean                     @default(false)
  idVerified                                  Boolean                     @default(false)
  rating                                      Float?                      @default(0)
  totalTransactions                           Int                         @default(0)
  totalReviews                                Int                         @default(0)
  createdDate                                 DateTime                    @default(now())
  updatedDate                                 DateTime                    @default(now())
  suspendedDate                               DateTime?
  suspendedReason                             String?
  username                                    String?                     @unique
  privacyPolicyAcceptedAt                     DateTime?
  privacyPolicyVersion                        String?
  stripeConnectId                             String?                     @unique
  stripeCustomerId                            String?                     @unique
  termsAcceptedAt                             DateTime?
  termsVersion                                String?
  providerPlan                                ProviderPlan                @default(FREE)
  stripeSubscriptionId                        String?                     @unique
  stripeSubscriptionStatus                    String?
  // FIX: Track when the current subscription period ends to honor paid plans until expiry
  subscriptionPeriodEnd                       DateTime?
  defaultPayoutSpeed                          PayoutSpeed                 @default(STANDARD)
  auditLogs                                  AuditLog[]
  disputesInitiated        Dispute[]                  @relation("disputes_initiatorIdTousers")
  disputesAgainst       Dispute[]                  @relation("disputes_respondentIdTousers")
  disputeEvidence                            DisputeEvidence[]
  emailVerificationTokens                   EmailVerificationToken[]
  insuranceDocuments                         InsuranceDocument[]
  messagesTo        Message[]                  @relation("messages_recipientIdTousers")
  messagesFrom           Message[]                  @relation("messages_senderIdTousers")
  notificationPreferences                    NotificationPreference?
  passwordHistory                            PasswordHistory[]
  passwordResetTokens                       PasswordResetToken[]
  pushSubscriptions                          PushSubscription[]
  quickRebooks                               QuickRebook[]
  referralsReceived       Referral[]                 @relation("referrals_referredIdTousers")
  referralsGiven       Referral[]                 @relation("referrals_referrerIdTousers")
  requestsCreated                                    Request[]
  reviewsReceived       Review[]                   @relation("reviews_reviewedUserIdTousers")
  reviewsGiven           Review[]                   @relation("reviews_reviewerIdTousers")
  savedSearches                              SavedSearch[]
  services                                    Service[]
  sessions                                    Session[]
  spaces                                      Space[]
  tools                                       Tool[]
  transactionsAsProvider Transaction[]              @relation("transactions_providerIdTousers")
  transactions     Transaction[]              @relation("transactions_userIdTousers")
  badges                                 UserBadge[]
  stats                                  UserStats?
  linkedAccounts                              LinkedAccount[]
  blogPostsCreated                            BlogPost[]                 @relation("blog_posts_createdBy")
  blogPostsUpdated                            BlogPost[]                 @relation("blog_posts_updatedBy")
  insuranceClaims                             InsuranceClaim[]           @relation("claimsFiled")
  insuranceClaimEvidence                      InsuranceClaimEvidence[]
  bookmarks                                   Bookmark[]
  invoiceSettings                             InvoiceSettings?
  tradeAccount                                TradeAccount?
  teamMemberships                             TeamMember[]
  invoices                                    Invoice[]
  aiFeedback                                  AIFeedback[]
  emailLogs                                   EmailLog[]
  availabilityHolds                           AvailabilityHold[]

  @@index([accountStatus])
  @@index([createdDate])
  @@index([email])
  @@index([postcode])
  @@index([accountStatus, createdDate])
  @@map("users")
}

