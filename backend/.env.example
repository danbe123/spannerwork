# Server
NODE_ENV=development
PORT=3000

# Database (with connection pooling for production)
# Development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spannerwork
# Production (recommended settings):
# DATABASE_URL=postgresql://user:pass@host:5432/db?connection_limit=10&pool_timeout=20&connect_timeout=10

# Database Connection Pool (applied automatically to DATABASE_URL)
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=20000
DB_CONNECT_TIMEOUT=10000

# Redis
REDIS_URL=redis://localhost:6379

# Security
SESSION_SECRET=your-session-secret-min-32-chars-change-in-production
CSRF_SECRET=your-csrf-secret-min-32-chars-change-in-production

# CORS
FRONTEND_URL=http://localhost:5173

# AWS S3 / Cloudflare R2
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_BUCKET_PUBLIC=spannerwork-public
S3_BUCKET_PRIVATE=spannerwork-private
CDN_URL=https://cdn.spannerwork.co.uk

# ============================================================================
# EMAIL CONFIGURATION (Mailtrap)
# ============================================================================
# Using Mailtrap Email Sending API: https://mailtrap.io/sending/domains
#
# Production Setup:
# 1. Add & verify domain: https://mailtrap.io/sending/domains
# 2. Add DNS records (SPF, DKIM, DMARC) shown in Mailtrap dashboard
# 3. Use API token from: https://mailtrap.io/api-tokens
# ============================================================================

MAILTRAP_API_KEY=your-mailtrap-api-key
EMAIL_FROM=noreply@spannerwork.co.uk
EMAIL_FROM_NAME=SpannerWork

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+44xxxxxxxxxx

# Web Push Notifications (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:noreply@spannerwork.co.uk

# ============================================================================
# GEOCODING SERVICES
# ============================================================================
# Default: Postcodes.io (UK postcodes, free, no key required)
# Fallback: Nominatim/OpenStreetMap (free, rate-limited to 1 req/sec)
# Optional: Google Maps or Mapbox for higher rate limits in production
# ============================================================================

NOMINATIM_USER_AGENT=SpannerWork/1.0
POSTCODES_IO_URL=https://api.postcodes.io

# Optional: Premium geocoding APIs for production (higher rate limits)
# Google Maps: https://console.cloud.google.com/apis/credentials
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
#
# Mapbox: https://account.mapbox.com/access-tokens/
# MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# ============================================================================
# AI SERVICES (Google Gemini)
# ============================================================================
# Powers: Smart matching, bundle suggestions, request optimization
# Get API key: https://makersuite.google.com/app/apikey
# ============================================================================

GEMINI_API_KEY=your-gemini-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn

# Platform Fees
PLATFORM_FEE_PERCENTAGE=5

# ============================================================================
# STRIPE CONNECT (Payment Processing)
# ============================================================================
# Powers: Marketplace payments, provider payouts, refunds
# Setup:
# 1. Create Stripe account: https://dashboard.stripe.com
# 2. Enable Connect: https://dashboard.stripe.com/connect/accounts/overview
# 3. Get API keys: https://dashboard.stripe.com/apikeys
# 4. Configure webhooks: https://dashboard.stripe.com/webhooks
#    - Endpoint: https://your-domain.com/api/webhooks/stripe
#    - Events: payment_intent.succeeded, account.updated, charge.refunded, etc.
# ============================================================================

STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Security Settings
SALT_ROUNDS=12
SESSION_EXPIRY_DAYS=30
PASSWORD_RESET_EXPIRY_HOURS=1
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# PII Encryption (generate with: openssl rand -hex 32)
# ENCRYPTION_KEY=your-64-character-hex-key-for-pii-encryption

# Virus Scanning (requires ClamAV daemon)
ENABLE_VIRUS_SCAN=false

# Database Backups (for backup-db.sh script)
BACKUP_RETENTION_DAYS=7
# S3_BUCKET=your-backup-bucket  # Optional: for remote backup storage
# AWS_REGION=eu-west-2          # Required if S3_BUCKET is set
