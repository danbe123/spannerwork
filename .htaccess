# Enable mod_rewrite
RewriteEngine On
RewriteBase /

# Redirect non-www to www (fixes SSL certificate warning)
RewriteCond %{HTTP_HOST} ^spannerwork\.co\.uk$ [NC]
RewriteRule ^(.*)$ https://www.spannerwork.co.uk/$1 [R=301,L]

# Redirect Cloudways subdomain to www
RewriteCond %{HTTP_HOST} ^phpstack-1566589-6092023\.cloudwaysapps\.com$ [NC]
RewriteRule ^(.*)$ https://www.spannerwork.co.uk/$1 [R=301,L]

# Proxy API requests to Node.js backend on port 3000
# Match any URL starting with /api/v1
RewriteCond %{REQUEST_URI} ^/api/v1
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]

# =============================================================================
# SERVE STATIC FILES FROM DIST FOLDER
# These files must be served directly, not via SPA fallback
# =============================================================================

# Serve robots.txt from dist
RewriteRule ^robots\.txt$ /dist/robots.txt [L]

# Serve sitemap.xml from dist
RewriteRule ^sitemap\.xml$ /dist/sitemap.xml [L]

# Serve manifest.json from dist
RewriteRule ^manifest\.json$ /dist/manifest.json [L]

# Serve service worker files from dist
RewriteRule ^registerSW\.js$ /dist/registerSW.js [L]
RewriteRule ^sw\.js$ /dist/sw.js [L]
RewriteRule ^workbox-.*\.js$ /dist/$0 [L]

# Serve PWA icons from dist
RewriteRule ^icons/(.*)$ /dist/icons/$1 [L]

# Serve apple-touch-icon from dist
RewriteRule ^apple-touch-icon\.(png|svg)$ /dist/apple-touch-icon.$1 [L]

# Serve static assets from dist/ folder (Vite build output)
RewriteCond %{REQUEST_URI} ^/assets/
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
RewriteRule ^(.*)$ /dist/$1 [L]

# Serve index.html from dist/ folder
RewriteRule ^index\.html$ /dist/index.html [L]

# Don't rewrite files or directories that exist in dist
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
RewriteRule ^(.*)$ /dist/$1 [L]

# Don't rewrite files or directories that exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Serve index.html for all other requests (React Router - SPA fallback)
RewriteRule ^ /dist/index.html [L]

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain text/xml
</IfModule>

# =============================================================================
# CACHING CONFIGURATION
# =============================================================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Images - 1 year (they rarely change)
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts - 1 year
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # CSS and JS with hash in filename - 1 year (cache-busted by Vite)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # HTML - no cache
  ExpiresByType text/html "access plus 0 seconds"

  # JSON and XML - short cache
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

# Cache control for HTML - no caching (SPA needs fresh index.html)
<FilesMatch "\.(html)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
  Header set Surrogate-Control "no-store"
</FilesMatch>

# Static assets with hash in filename (Vite build output) - long cache
# Files like: index-DS1QM3zm.js, vendor-react-Icuj735j.js
# Surrogate-Control tells Varnish/CDN to cache for 1 year
# Note: Cloudways Varnish may override Cache-Control - configure via Cloudways panel
<FilesMatch "\.(js|css)$">
  Header unset Cache-Control
  Header unset Expires
  Header always set Cache-Control "public, max-age=31536000, immutable, stale-while-revalidate=86400"
  Header always set Surrogate-Control "max-age=31536000"
  Header always set X-Accel-Expires "31536000"
</FilesMatch>

# Service Worker files - MUST have short cache (overrides general JS rule above)
# These need updates to propagate quickly for PWA functionality
<FilesMatch "^(sw|registerSW|workbox.*)\.js$">
  Header always set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>

# Images and fonts - long cache
<FilesMatch "\.(ico|gif|jpg|jpeg|png|webp|avif|svg|woff|woff2|ttf|eot)$">
  Header unset Cache-Control
  Header unset Expires
  Header always set Cache-Control "public, max-age=31536000, immutable, stale-while-revalidate=86400"
  Header always set Surrogate-Control "max-age=31536000"
  Header always set X-Accel-Expires "31536000"
</FilesMatch>

# robots.txt and sitemap.xml - moderate cache
<FilesMatch "(robots\.txt|sitemap\.xml)$">
  Header set Cache-Control "public, max-age=86400"
</FilesMatch>

# manifest.json - moderate cache
<FilesMatch "manifest\.json$">
  Header set Cache-Control "public, max-age=86400"
</FilesMatch>

# =============================================================================
# SECURITY HEADERS
# =============================================================================
<IfModule mod_headers.c>
  # Content Security Policy
  # Security improvements:
  # - script-src uses hash + 'unsafe-inline' fallback for older browsers
  #   Modern browsers ignore 'unsafe-inline' when hash/nonce is present (CSP Level 2+)
  # - style-src requires 'unsafe-inline' for dynamic React styles
  # - Trusted Types enforced to prevent DOM-based XSS (innerHTML, document.write, etc.)
  #   Policies 'default' and 'dompurify' are created in src/lib/trusted-types.ts
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-1s0LpPfwn9dm7dBgZw4wiCa4VtBx6GosyCDXDna+gbM=' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://*.s3.amazonaws.com https://*.r2.cloudflarestorage.com https://*.cloudflare.com https://picsum.photos https://*.picsum.photos https://images.unsplash.com blob:; connect-src 'self' https://api.mapbox.com https://*.tiles.mapbox.com https://events.mapbox.com wss://www.spannerwork.co.uk; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; require-trusted-types-for 'script'; trusted-types default dompurify 'allow-duplicates';"

  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Clickjacking protection
  Header set X-Frame-Options "SAMEORIGIN"

  # XSS Protection (legacy browsers - disabled as modern browsers don't need it)
  Header set X-XSS-Protection "0"

  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy (restrict browser features)
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"

  # HSTS - Force HTTPS (1 year)
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Cross-Origin-Opener-Policy - Isolate top-level browsing context
  Header set Cross-Origin-Opener-Policy "same-origin"

  # Cross-Origin-Embedder-Policy - Require CORS for cross-origin resources
  # Note: Using unsafe-none to avoid breaking third-party images (S3, Cloudflare)
  Header set Cross-Origin-Embedder-Policy "unsafe-none"
</IfModule>
