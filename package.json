{
  "name": "spannerwork",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "shared:build": "npm run build -w @spannerwork/shared",
    "shared:dev": "npm run dev -w @spannerwork/shared",
    "dev:backend:up": "docker compose up -d backend",
    "dev:backend:logs": "docker compose logs -f --tail=200 backend",
    "dev:down": "docker compose down",
    "dev:free:5173": "bash -lc \"PORT=5173; PIDS=''; if command -v lsof >/dev/null 2>&1; then PIDS=$(lsof -tiTCP:${PORT} -sTCP:LISTEN 2>/dev/null || true); elif command -v fuser >/dev/null 2>&1; then PIDS=$(fuser -n tcp ${PORT} 2>/dev/null || true); else echo 'dev:free:5173 requires lsof or fuser (psmisc) to be installed' >&2; exit 1; fi; if [ -n \"$PIDS\" ]; then echo \"Freeing port ${PORT} (killing PIDs: $PIDS)\"; kill -TERM $PIDS 2>/dev/null || true; sleep 1; kill -KILL $PIDS 2>/dev/null || true; fi\"",
    "dev:wait:backend": "node --input-type=module -e \"import http from 'node:http'; const url='http://localhost:3000/health'; const start=Date.now(); const timeoutMs=60000; const attempt=()=>{ const req=http.get(url,res=>{ const reachable = typeof res.statusCode==='number'; res.resume(); if(reachable){ process.exit(0); } retry(); }); req.on('error', retry); }; const retry=()=>{ if(Date.now()-start>timeoutMs){ console.error('Backend did not become reachable within 60s:', url); process.exit(1); } setTimeout(attempt, 1000); }; attempt();\"",
    "dev:full": "npm run dev:free:5173 && npm run dev:backend:up && npm run dev:wait:backend && npm run dev -- --host 0.0.0.0 --port 5173 --strictPort",
    "dev:full:strict": "npm run dev:backend:up && npm run dev:wait:backend && npm run dev -- --host 0.0.0.0 --port 5173 --strictPort",
    "dev": "vite",
    "build": "vite build && node scripts/optimize-html.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.2",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/react": "^10.40.0",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.8.0",
    "@tanstack/react-query": "^5.90.21",
    "@types/dompurify": "^3.2.0",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "dompurify": "^3.3.1",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^12.34.3",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "next-themes": "^0.4.4",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
