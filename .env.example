# Docker Compose Environment Variables
# Copy this file to .env and update the values
# For backend-specific config, see backend/.env.example

# ============================================================================
# CORE SETTINGS (REQUIRED)
# ============================================================================

# Environment
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Database Credentials (REQUIRED for Docker)
# Generate a secure password: openssl rand -base64 24
POSTGRES_DB=spannerwork
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-database-password-here

# Redis Password (REQUIRED for production Docker)
# REDIS_PASSWORD=your-secure-redis-password

# Security Secrets (REQUIRED - must be at least 32 characters)
# Generate secure secrets: openssl rand -hex 32
SESSION_SECRET=your-secure-session-secret-minimum-32-characters-here
CSRF_SECRET=your-secure-csrf-secret-minimum-32-characters-here

# ============================================================================
# AWS S3 / CLOUDFLARE R2 (for file uploads)
# ============================================================================

AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_BUCKET_PUBLIC=spannerwork-public
S3_BUCKET_PRIVATE=spannerwork-private
CDN_URL=https://cdn.spannerwork.co.uk

# ============================================================================
# EMAIL (Resend)
# ============================================================================

RESEND_API_KEY=re_your_api_key
EMAIL_FROM=noreply@spannerwork.co.uk
EMAIL_FROM_NAME=SpannerWork

# ============================================================================
# SMS (Twilio)
# ============================================================================

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+44xxxxxxxxxx

# ============================================================================
# MONITORING (Sentry)
# ============================================================================

# Backend Sentry DSN
SENTRY_DSN=your-sentry-dsn

# Frontend Sentry DSN (Vite env variable)
VITE_SENTRY_DSN=your-frontend-sentry-dsn

# ============================================================================
# FRONTEND (Vite)
# ============================================================================

# API URL for frontend (in Docker, uses localhost:3000)
VITE_API_URL=http://localhost:3000/api/v1

# WebSocket URL for real-time features (defaults to API URL without /api/v1)
VITE_SOCKET_URL=http://localhost:3000

# CDN Configuration (optional, for production static assets)
# VITE_CDN_URL=https://cdn.yourdomain.com/

# ============================================================================
# PLATFORM SETTINGS
# ============================================================================

PLATFORM_FEE_PERCENTAGE=5
